<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hmtika_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/attendanceTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hmtika_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBackAttendance"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/hmtika_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_screen_title"
                android:textColor="@color/hmtika_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_screen_subtitle"
                android:textColor="@color/hmtika_teal"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Agenda & Clock Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/hmtika_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/hmtika_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_amber"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="AGENDA RAPAT HARI INI"
                        android:textColor="@color/amber_warning"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/agenda_label"
                        android:textColor="@color/hmtika_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spMeetingAgenda"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_role_container"
                        android:paddingHorizontal="12dp" />

                    <!-- Live Timestamp Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_teal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Live Clock"
                            android:src="@drawable/ic_location_24"
                            app:tint="@color/hmtika_teal" />

                        <TextView
                            android:id="@+id/tvLiveClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/hmtika_teal_dark"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Sekretariat HMTIKA • 21 Oktober 2026, 16:04:12 WIB" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera Viewfinder Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/hmtika_teal"
                app:strokeWidth="1.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp">

                    <!-- CameraX Preview -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/cameraPreviewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Captured Snapshot Image View -->
                    <ImageView
                        android:id="@+id/ivCapturedSnapshot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto Presensi"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Top Reticle & Camera Switch Button -->
                    <ImageButton
                        android:id="@+id/btnSwitchCamera"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_badge_teal"
                        android:contentDescription="Ganti Kamera"
                        android:src="@drawable/ic_cameraswitch_24"
                        app:tint="@color/hmtika_teal_dark" />

                    <!-- Overlay Label -->
                    <TextView
                        android:id="@+id/tvCameraOverlayHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_tagline_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Posisikan wajah Anda dengan jelas"
                        android:textColor="@color/hmtika_teal_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Capture & Retake Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCapturePhoto"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/hmtika_teal_subtle"
                    android:text="@string/capture_btn"
                    android:textAllCaps="false"
                    android:textColor="@color/hmtika_teal_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_camera_24"
                    app:iconTint="@color/hmtika_teal_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetakePhoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Foto Ulang"
                    android:textAllCaps="false"
                    android:textColor="@color/hmtika_text_secondary"
                    android:visibility="gone"
                    app:cornerRadius="10dp"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Notes Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAttendanceNotes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Catatan Presensi (Lokasi / Keterangan)"
                app:boxStrokeColor="@color/hmtika_teal"
                app:hintTextColor="@color/hmtika_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAttendanceNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hadir di Sekretariat HMTIKA"
                    android:textColor="@color/hmtika_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAttendance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/hmtika_teal"
                android:text="@string/submit_presence_btn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_verified_24"
                app:iconTint="@color/white" />

            <!-- Presence History List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/presence_history_title"
                android:textColor="@color/hmtika_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttendanceHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_attendance" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
