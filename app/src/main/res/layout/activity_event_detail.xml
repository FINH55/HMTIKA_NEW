<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eventDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hmtika_background"
    android:orientation="vertical">

    <!-- Top Banner with Back Button & Title -->
    <FrameLayout
        android:id="@+id/bannerHeader"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/hmtika_teal_dark">

        <!-- Top Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnBackDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_role_container"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDetailCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="SEMINAR" />
        </LinearLayout>

        <!-- Bottom Banner Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Tech Talk: Artificial Intelligence &amp; Gemini in Android" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Himpunan Mahasiswa Informatika • STIMIK Tunas Bangsa"
                android:textColor="@color/hmtika_teal_light"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Key Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/hmtika_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/hmtika_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Kegiatan"
                        android:textColor="@color/hmtika_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Date & Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Date"
                            android:src="@drawable/ic_calendar_24"
                            app:tint="@color/hmtika_teal" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tanggal &amp; Waktu"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hmtika_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="28 Oktober 2026 • 09.00 - 12.00 WIB" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Location"
                            android:src="@drawable/ic_location_24"
                            app:tint="@color/electric_blue" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lokasi / Tempat"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hmtika_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Ruang Teater Gedung B &amp; Zoom Live" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Speaker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Speaker"
                            android:src="@drawable/ic_person_24"
                            app:tint="@color/hmtika_amber" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Narasumber / Dewan Juri"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailSpeaker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hmtika_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Aris Setiawan (Google Developer Expert)" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quota -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Quota"
                            android:src="@drawable/ic_verified_24"
                            app:tint="@color/mint_success" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kapasitas Peserta"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailQuota"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hmtika_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="124 dari 150 Mahasiswa Terdaftar" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/hmtika_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/hmtika_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tentang Kegiatan Ini"
                        android:textColor="@color/hmtika_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/hmtika_text_secondary"
                        android:textSize="13sp"
                        tools:text="Bedah tuntas implementasi arsitektur modern Android Jetpack Compose dan integrasi On-Device AI Gemini. Free snack, sertifikat ber-SKPI, dan networking eksklusif sesama tech enthusiast." />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Benefit Peserta:"
                        android:textColor="@color/hmtika_teal_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="• E-Sertifikat resmi HMTIKA ber-barcode verifikasi (SKPI)\n• Modul materi &amp; source code praktikum\n• Konsumsi &amp; networking sesama mahasiswa"
                        android:textColor="@color/hmtika_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Role Section 1: Mahasiswa E-Certificate Container -->
            <LinearLayout
                android:id="@+id/sectionMahasiswaCert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-Sertifikat Kegiatan"
                    android:textColor="@color/hmtika_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Claim Certificate Card (if not claimed) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClaimCert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/hmtika_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/hmtika_teal_light"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Certificate"
                            android:src="@drawable/ic_verified_24"
                            app:tint="@color/hmtika_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/claim_cert_title"
                            android:textColor="@color/hmtika_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClaimSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Sertifikat resmi langsung diterbitkan atas nama Mahasiswa terdaftar"
                            android:textColor="@color/hmtika_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClaimCert"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="@color/hmtika_teal"
                            android:text="@string/btn_claim_cert"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Certificate Preview Card (if claimed) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCertificatePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/hmtika_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/hmtika_teal"
                    app:strokeWidth="2dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="HMTIKA • STIMIK Tunas Bangsa"
                                android:textColor="@color/hmtika_teal_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_success"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="TERVERIFIKASI RESMI"
                                android:textColor="@color/mint_success"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="SERTIFIKAT PARTISIPASI"
                            android:textColor="@color/hmtika_teal_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCertNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hmtika_text_secondary"
                            android:textSize="11sp"
                            tools:text="Nomor: HMTIKA/CERT/2026/042" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Diberikan kepada:"
                            android:textColor="@color/hmtika_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCertRecipientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hmtika_teal_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Bagus Prasetyo" />

                        <TextView
                            android:id="@+id/tvCertRecipientNim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hmtika_text_secondary"
                            android:textSize="12sp"
                            tools:text="NIM: 2301010042" />

                        <!-- Signatures & QR Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="ttd.\nKetua Himpunan"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="10sp" />

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="QR Code"
                                android:src="@drawable/ic_qr_code_24"
                                app:tint="@color/hmtika_teal" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="ttd.\nKetua Pelaksana"
                                android:textColor="@color/hmtika_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadCertPdf"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/hmtika_teal"
                            android:text="@string/btn_download_cert"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_file_download_24"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Role Section 2: Pengurus Rekap Kehadiran Container -->
            <LinearLayout
                android:id="@+id/sectionPengurusRekap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rekap_title"
                        android:textColor="@color/hmtika_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportRekap"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/hmtika_teal_subtle"
                        android:text="@string/btn_export_rekap"
                        android:textAllCaps="false"
                        android:textColor="@color/hmtika_teal_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_file_download_24"
                        app:iconTint="@color/hmtika_teal_dark" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEventAttendees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_attendance" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
