<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hmtika_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Logo Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginLogo"
            android:layout_width="86dp"
            android:layout_height="86dp"
            app:cardCornerRadius="43dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/hmtika_teal"
            app:strokeWidth="2.5dp">

            <ImageView
                android:id="@+id/ivLoginLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hmtika_official_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_full_title"
            android:textColor="@color/hmtika_teal_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginCampus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.05"
            android:text="@string/campus_name"
            android:textColor="@color/hmtika_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/hmtika_amber"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Form Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/hmtika_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/hmtika_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvCardHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textColor="@color/hmtika_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardSubheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/hmtika_text_secondary"
                    android:textSize="12sp" />

                <!-- Role Selector Tabs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Pilih Role Akses"
                    android:textColor="@color/hmtika_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/roleTabsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabMahasiswa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_role_tab_selected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/role_mahasiswa"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabPengurus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_role_tab_unselected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/role_pengurus"
                        android:textColor="@color/hmtika_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Input NIM / Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNimEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hint_nim_email"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNimEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hint_password"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_camera_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error Message Banner -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_amber"
                    android:padding="10dp"
                    android:textColor="@color/coral_error"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Password yang Anda masukkan salah."
                    tools:visibility="visible" />

                <!-- Login Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/hmtika_teal"
                    android:text="@string/btn_login"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/pbLoginLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/hmtika_teal"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Demo Credentials Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/hmtika_surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/hmtika_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDemoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_demo_title"
                    android:textColor="@color/hmtika_teal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDemoSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick_demo_subtitle"
                    android:textColor="@color/hmtika_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoMahasiswa"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/hmtika_teal_subtle"
                        android:text="@string/demo_mahasiswa_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/hmtika_teal_dark"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/hmtika_teal_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoPengurus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/amber_warning_bg"
                        android:text="@string/demo_pengurus_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/amber_warning"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/hmtika_amber" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Register Link Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account_prompt"
                android:textColor="@color/hmtika_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRegisterLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="8dp"
                android:text="@string/link_register"
                android:textColor="@color/hmtika_teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
