<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hmtika_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Logo Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/hmtika_teal"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hmtika_official_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Buat Akun Baru"
            android:textColor="@color/hmtika_teal_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Selamat Datang di HMTIKA App"
            android:textColor="@color/hmtika_text_secondary"
            android:textSize="12sp" />

        <!-- Form Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/hmtika_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/hmtika_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Role Selector Tabs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Sebagai"
                    android:textColor="@color/hmtika_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabRegMahasiswa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_role_tab_selected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/role_mahasiswa"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabRegPengurus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_role_tab_unselected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/role_pengurus"
                        android:textColor="@color/hmtika_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Input Nama Lengkap -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hint_name"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input NIM -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegNim"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nomor Induk Mahasiswa (NIM)"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegNim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email Kampus Resmi"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_password"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_camera_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Confirm Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegConfirmPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_confirm_password"
                    app:boxStrokeColor="@color/hmtika_teal"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/hmtika_teal"
                    app:startIconDrawable="@drawable/ic_camera_24"
                    app:startIconTint="@color/hmtika_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Conditional PIN Pengurus Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegPin"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_pin_pengurus"
                    android:visibility="gone"
                    app:boxStrokeColor="@color/hmtika_amber"
                    app:hintTextColor="@color/hmtika_amber"
                    app:startIconDrawable="@drawable/ic_camera_24"
                    app:startIconTint="@color/hmtika_amber"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:textColor="@color/hmtika_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error Message Banner -->
                <TextView
                    android:id="@+id/tvRegError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_amber"
                    android:padding="10dp"
                    android:textColor="@color/coral_error"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Konfirmasi password tidak sesuai."
                    tools:visibility="visible" />

                <!-- Register Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/hmtika_teal"
                    android:text="@string/btn_register"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/pbRegLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/hmtika_teal"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Login Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/have_account_prompt"
                android:textColor="@color/hmtika_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="8dp"
                android:text="@string/link_login"
                android:textColor="@color/hmtika_teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
