<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAnnouncementItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/hmtika_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/hmtika_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAnnouncePriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_amber"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/amber_warning"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PENTING" />

            <TextView
                android:id="@+id/tvAnnounceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/hmtika_teal"
                android:textSize="10sp"
                tools:text="Core Team Only" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Delete Button (for Pengurus) -->
            <ImageButton
                android:id="@+id/btnDeleteAnnouncement"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hapus Info"
                android:src="@drawable/ic_logout_24"
                android:tint="@color/coral_error"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAnnounceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/hmtika_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Wajib: Rapat Pleno Core Team HMTIKA Evaluasi Program Kerja" />

        <TextView
            android:id="@+id/tvAnnounceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/hmtika_text_secondary"
            android:textSize="12sp"
            tools:text="Seluruh jajaran pengurus Core Team HMTIKA diwajibkan hadir pada Rapat Pleno di Sekretariat..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAnnounceAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hmtika_teal_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Sekretariat Jenderal HMTIKA" />

            <TextView
                android:id="@+id/tvAnnounceDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hmtika_text_muted"
                android:textSize="11sp"
                tools:text="Hari Ini, 16.00 WIB" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
